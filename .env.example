# Copy to .env and fill in your values before running `sudo docker compose up -d --build`.

# Set to "0" for real Minecraft accounts (Mojang sessionserver auth).
# Only set to "1" temporarily if testing with Loom dev clients (runClientMeeyah/Testbunny).
BURROW_DEV_MODE=0

# Discord OAuth2 app for the /admin dashboard (https://discord.com/developers/applications)
# Leave blank if you want to start the server first and wire up /admin right after.
BURROW_DISCORD_CLIENT_ID=
BURROW_DISCORD_CLIENT_SECRET=
BURROW_DISCORD_REDIRECT_URI=https://burrow.meeyah.dev/admin/callback
BURROW_DISCORD_ALLOWED_USER_ID=

# Keep "1" when served over HTTPS (Caddy or Cloudflare Tunnel).
# Set to "0" only if accessing /admin over plain LAN HTTP (http://192.168.0.126:8787/admin).
BURROW_SECURE_COOKIES=1

# Optional static bearer token for scripts / headless /admin/metrics checks
BURROW_ADMIN_TOKEN=

# Optional: only needed if using the cloudflared sidecar in docker-compose.yml
# CLOUDFLARED_TOKEN=
