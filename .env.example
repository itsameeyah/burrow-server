# Copy to .env and fill in any optional values you need.
# You can run `docker compose up -d --build` without a .env file for a basic
# relay server — everything below is optional unless you want /admin or
# Cloudflare Tunnel.

# Host port to expose Burrow on (default: 8787)
BURROW_PORT=8787

# Keep "0" for real Minecraft accounts (Mojang sessionserver auth).
# Only set to "1" for local offline dev clients.
BURROW_DEV_MODE=0

# Optional: Discord OAuth2 app for the /admin dashboard
# (https://discord.com/developers/applications)
BURROW_DISCORD_CLIENT_ID=
BURROW_DISCORD_CLIENT_SECRET=
BURROW_DISCORD_REDIRECT_URI=https://burrow.example.com/admin/callback
BURROW_DISCORD_ALLOWED_USER_ID=

# Keep "1" when served over HTTPS (Caddy, Nginx, or Cloudflare Tunnel).
# Set to "0" only if accessing /admin over plain HTTP on a local network.
BURROW_SECURE_COOKIES=1

# Optional static bearer token for headless /admin/metrics checks
BURROW_ADMIN_TOKEN=

# Optional: Cloudflare Tunnel token (used with `docker compose --profile tunnel up -d`)
CLOUDFLARED_TOKEN=
